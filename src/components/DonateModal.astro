---
import { site } from '../data/site';
---
<div class="modal" id="donate-modal" role="dialog" aria-modal="true" aria-label="donate">
  <div class="sheet">
    <button class="g-btn icon close-x" data-donate-close aria-label="close">✕</button>
    <h3 class="section-title" style="text-align:center" data-i18n="donate.title">打赏</h3>
    <p class="section-desc" style="text-align:center;max-width:34ch;margin-inline:auto" data-i18n="donate.desc">
      善待留守儿童，多点关心多点爱
    </p>
    <div class="amount-row">
      {site.donate.amounts.map((a) => (
        <button class="g-btn amount-chip" data-amount={a}>¥{a}</button>
      ))}
      <button class="g-btn amount-chip" data-amount="custom" data-i18n="donate.custom">自定义</button>
    </div>
    <p class="donate-note" id="donate-note" data-i18n="donate.presetNote">推荐金额</p>
    <div class="qr-tabs">
      <button class="g-btn pill" data-qr={site.donate.wechatQR} aria-pressed="true" data-i18n="donate.wechat">微信赞赏码</button>
      <button class="g-btn pill" data-qr={site.donate.alipayQR} aria-pressed="false" data-i18n="donate.alipay">支付宝</button>
    </div>
    <div class="qr-stage">
      <img id="donate-qr" src={site.donate.wechatQR} alt="赞赏码 / 收款码" />
    </div>
    {site.donate.afdian && (
      <p style="text-align:center;margin:10px 0 0">
        <a class="g-btn pill primary" href={site.donate.afdian} target="_blank" rel="noopener" data-i18n="donate.afdian">爱发电</a>
      </p>
    )}
  </div>
</div>
<script>
  import { getT } from '../i18n/ui';

  // 全部用 document 级事件委托：只绑定一次，跨页面导航（View Transitions）后依然有效
  const t = () => getT((localStorage.getItem('woju-lang') as 'zh' | 'en') || 'zh').donate;

  function noteText(modal: HTMLElement): string {
    const amount = modal.dataset.amount;
    if (!amount) return t().presetNote;
    return amount === 'custom' ? t().customNote : `¥${amount} · ${t().customNote}`;
  }

  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const modal = document.getElementById('donate-modal');
    if (!modal) return;

    if (el.closest('[data-donate-open]')) {
      modal.querySelector<HTMLElement>('#donate-note')!.textContent = noteText(modal);
      modal.classList.add('open');
      document.querySelectorAll<HTMLButtonElement>('[data-donate-open]').forEach((b) => b.setAttribute('aria-expanded', 'true'));
      return;
    }
    if (el.closest('[data-donate-close]') || el.id === 'donate-modal') {
      modal.classList.remove('open');
      document.querySelectorAll<HTMLButtonElement>('[data-donate-open]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      return;
    }

    const chip = el.closest<HTMLElement>('.amount-chip');
    if (chip) {
      modal.querySelectorAll<HTMLButtonElement>('.amount-chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      modal.dataset.amount = chip.dataset.amount ?? '';
      modal.querySelector<HTMLElement>('#donate-note')!.textContent = noteText(modal);
      return;
    }

    const tab = el.closest<HTMLElement>('[data-qr]');
    if (tab) {
      modal.querySelectorAll<HTMLButtonElement>('[data-qr]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      tab.setAttribute('aria-pressed', 'true');
      modal.querySelector<HTMLImageElement>('#donate-qr')!.src = tab.dataset.qr!;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.getElementById('donate-modal')?.classList.remove('open');
  });
</script>
