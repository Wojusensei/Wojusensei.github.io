---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div>© {year} {site.name} · <span data-i18n="footer.built">由 Astro 构建 · 托管于 GitHub Pages</span></div>
  <!-- 访客总量（不蒜子计数）：优先显示 localStorage 缓存，网络波动拿不到新数据时保持缓存值 -->
  <div class="visitor-line">
    <span id="busuanzi_container_site_uv" style="display:none">
      <span data-i18n="footer.visitors">访客总量</span> <span id="busuanzi_value_site_uv">-</span>
    </span>
  </div>
</footer>
<script>
  const UV_KEY = 'woju-uv';

  // 回填页脚计数行（容器显示 + 数值）
  function applyFooter(v: string) {
    const container = document.getElementById('busuanzi_container_site_uv');
    const value = document.getElementById('busuanzi_value_site_uv');
    if (container && value) {
      value.textContent = v;
      container.style.display = '';
    }
  }

  // 把访客数回填到首页资料卡统计（若曾被隐藏则恢复显示）
  function applyProfileCard(v: string) {
    const pc = document.getElementById('pc-uv');
    if (!pc) return;
    const stat = pc.closest<HTMLElement>('.pc-stat');
    if (stat) stat.style.display = '';
    pc.textContent = v;
  }

  // 首页资料卡在「无缓存且始终拿不到数据」时整体隐藏这一项，避免挂着 – 显得坏了
  function hideProfileCardStat() {
    const stat = document.getElementById('pc-uv')?.closest<HTMLElement>('.pc-stat');
    if (stat) stat.style.display = 'none';
  }

  function applyVisitorCount(v: string) {
    applyProfileCard(v);
    applyFooter(v);
  }

  // 不蒜子脚本按页加载：View Transitions 导航后 DOM 被替换，数值需要重新回填；
  // 模块本身只执行一次，因此挂 astro:page-load 重注入脚本（访客数按 IP 去重，重复加载不虚增）
  document.addEventListener('astro:page-load', () => {
    // 1) 缓存优先：先显示上次拿到的数值，网络波动时页面不再出现 – 或整行消失。
    //    注意：页脚计数值元素保持 '-' 不动——它是「不蒜子是否已真实返回」的判定信号，
    //    若把缓存写进去，轮询会误判新数据已到而提前退出（PC 端曾因此永远停在旧值）。
    let cached: string | null = null;
    try { cached = localStorage.getItem(UV_KEY); } catch { /* 存储不可用时忽略 */ }
    if (cached) {
      applyProfileCard(cached);
      const container = document.getElementById('busuanzi_container_site_uv');
      if (container) container.style.display = '';
    }

    // 2) 注入不蒜子脚本拉取最新值
    document.querySelectorAll<HTMLScriptElement>('script[data-busuanzi]').forEach((s) => s.remove());
    const s = document.createElement('script');
    s.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
    s.async = true;
    s.dataset.busuanzi = '';
    document.body.append(s);

    // 3) 轮询新数据：busuanzi_value 被填上真实值（≠'-'）才算返回；
    //    拿到即刷新缓存并更新显示；约 12s 未拿到 → 20s 后重试一轮，仍拿不到且无缓存则隐藏统计项
    const startPoll = (onGiveUp: () => void) => {
      let tries = 0;
      const tick = () => {
        const v = document.getElementById('busuanzi_value_site_uv')?.textContent;
        if (v && v !== '-') {
          try { localStorage.setItem(UV_KEY, v); } catch { /* 静默 */ }
          applyVisitorCount(v);
          return;
        }
        if (++tries < 40) setTimeout(tick, 300);
        else onGiveUp();
      };
      tick();
    };
    startPoll(() => {
      setTimeout(() => {
        startPoll(() => {
          let stillNoCache: string | null = null;
          try { stillNoCache = localStorage.getItem(UV_KEY); } catch { /* 静默 */ }
          if (!stillNoCache) hideProfileCardStat();
        });
      }, 20000);
    });
  });
</script>
