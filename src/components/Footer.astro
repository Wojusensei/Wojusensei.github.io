---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div>© {year} {site.name} · <span data-i18n="footer.built">由 Astro 构建 · 托管于 GitHub Pages</span></div>
  <!-- 访客总量（不蒜子计数）：优先显示 localStorage 缓存，网络波动拿不到新数据时保持缓存值 -->
  <div class="visitor-line">
    <span id="busuanzi_container_site_uv" style="display:none">
      <span data-i18n="footer.visitors">访客总量</span> <span id="busuanzi_value_site_uv">-</span>
    </span>
  </div>
</footer>
<script>
  const UV_KEY = 'woju-uv';

  // 把访客数同时回填到页脚计数行与首页资料卡统计
  function applyVisitorCount(v: string) {
    const pc = document.getElementById('pc-uv');
    if (pc) pc.textContent = v;
    const container = document.getElementById('busuanzi_container_site_uv');
    const value = document.getElementById('busuanzi_value_site_uv');
    if (container && value) {
      value.textContent = v;
      container.style.display = '';
    }
  }

  // 不蒜子脚本按页加载：View Transitions 导航后 DOM 被替换，数值需要重新回填；
  // 模块本身只执行一次，因此挂 astro:page-load 重注入脚本（访客数按 IP 去重，重复加载不虚增）
  document.addEventListener('astro:page-load', () => {
    // 1) 缓存优先：先显示上次拿到的数值，网络波动时页面不再出现 – 或整行消失
    let cached: string | null = null;
    try { cached = localStorage.getItem(UV_KEY); } catch { /* 存储不可用时忽略 */ }
    if (cached) applyVisitorCount(cached);

    // 2) 注入不蒜子脚本拉取最新值
    document.querySelectorAll<HTMLScriptElement>('script[data-busuanzi]').forEach((s) => s.remove());
    const s = document.createElement('script');
    s.src = 'https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
    s.async = true;
    s.dataset.busuanzi = '';
    document.body.append(s);

    // 3) 轮询新数据：拿到即刷新缓存并更新显示；约 12s 仍拿不到就保持缓存
    let tries = 0;
    const poll = () => {
      const v = document.getElementById('busuanzi_value_site_uv')?.textContent;
      if (v && v !== '-') {
        try { localStorage.setItem(UV_KEY, v); } catch { /* 静默 */ }
        applyVisitorCount(v);
        return;
      }
      if (++tries < 40) setTimeout(poll, 300);
    };
    poll();
  });
</script>
