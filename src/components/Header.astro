---
import Icon from './Icon.astro';

interface Props { active?: string; }
const { active = '' } = Astro.props;

const nav = [
  { key: 'home', href: '/' },
  { key: 'works', href: '/works/' },
  { key: 'contributions', href: '/contributions/' },
  { key: 'blog', href: '/blog/' },
  { key: 'friends', href: '/friends/' },
  { key: 'about', href: '/about/' },
];
---
<header class="site-header">
  <div class="bar">
    <a class="logo" href="/"><Icon name="droplet" />Wojusensei</a>
    <nav class="nav-links" id="nav-links">
      {nav.map((n) => (
        <a href={n.href} class:list={[{ active: active === n.key }]} data-i18n={`nav.${n.key}`}>
          {{ home: '首页', works: '作品', contributions: '贡献', blog: '博客', friends: '友链', about: '关于' }[n.key]}
        </a>
      ))}
    </nav>
    <div class="header-controls">
      <button id="lang-toggle" class="g-btn pill" aria-label="切换语言" data-i18n-attr="aria-label:misc.langToggle">EN</button>
      <button id="theme-toggle" class="g-btn icon" aria-label="切换亮暗" data-i18n-attr="aria-label:misc.themeToggle">
        <span class="i-sun"><Icon name="sun" /></span>
        <span class="i-moon"><Icon name="moon" /></span>
      </button>
      <button class="g-btn icon menu-toggle" id="menu-toggle" aria-label="菜单" aria-expanded="false" aria-controls="nav-links"><Icon name="menu" /></button>
    </div>
  </div>
</header>
<script>
  // 挂 astro:page-load：首次加载与每次客户端导航后重新绑定（header 会被整体替换）
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('nav-links');
    const bar = toggle?.closest('.bar');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open') ?? false;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      // 展开时把菜单挪出 .bar：.bar 自带 backdrop-filter，会把后代玻璃的取景
      // 限制在导航条内部，下拉面板模糊不到底下的页面内容（表现为透明）
      if (!nav || !bar) return;
      const header = bar.parentElement;
      if (open) {
        if (nav.parentElement !== header) header?.appendChild(nav);
      } else {
        const controls = bar.querySelector('.header-controls');
        if (nav.parentElement === header && controls) bar.insertBefore(nav, controls);
      }
    });
  });
</script>
