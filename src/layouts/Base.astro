---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonateModal from '../components/DonateModal.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../data/site';

interface Props { title?: string; desc?: string; active?: string; ogImage?: string; }
const { title, desc = `${site.name} 的个人空间：作品、博客与联系方式`, active = '', ogImage } = Astro.props;
// 分享卡图：页面未指定时用全站默认封面
const ogImageFinal = ogImage ?? `${site.url}/images/cover-blog.webp`;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---
<!doctype html>
<html data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 星空底图在 CSS 里引用，preload 让它更早开始下载（首屏 LCP） -->
    <link rel="preload" as="image" href="/images/bg.webp" fetchpriority="high" />
    <ClientRouter />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={ogImageFinal} />
    <link rel="alternate" type="application/rss+xml" title="Wojusensei 的博客" href="/rss.xml" />
    <script is:inline>
      // 防主题闪烁：渲染前定下亮暗；客户端导航后 html 属性会被新页面重置，需再应用一次
      (function () {
        function applyTheme() {
          try {
            var t = localStorage.getItem('woju-theme');
            if (t !== 'dark' && t !== 'light') {
              t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.dataset.theme = t;
          } catch (e) {}
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <!-- 首次进站加载幕：每会话一次（sessionStorage），客户端导航与后续刷新不出现；3.5s 兜底必消失 -->
    <script is:inline>
      (function () {
        try { if (sessionStorage.getItem('woju-veil')) return; } catch (e) {}
        try { sessionStorage.setItem('woju-veil', '1'); } catch (e) {}
        var d = document.createElement('div');
        d.id = 'load-veil';
        d.innerHTML = '<span class="veil-name">Wojusensei</span><span class="veil-spinner"></span>';
        document.body.insertBefore(d, document.body.firstChild);
        var done = function () {
          d.classList.add('veil-done');
          setTimeout(function () { if (d.parentNode) d.parentNode.removeChild(d); }, 500);
        };
        if (document.readyState === 'complete') done();
        else window.addEventListener('load', done);
        setTimeout(done, 3500);
      })();
    </script>
    <a class="skip-link" href="#main" data-i18n="misc.skip">跳到正文</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DonateModal />
    <BackToTop />
    <script>
      import '../lib/glass/main';
    </script>
  </body>
</html>
