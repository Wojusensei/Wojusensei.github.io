---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonateModal from '../components/DonateModal.astro';
import BackToTop from '../components/BackToTop.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props { title?: string; desc?: string; active?: string; ogImage?: string; }
const { title, desc = `${site.name} 的个人空间：作品、博客与联系方式`, active = '', ogImage } = Astro.props;
// 分享卡图：页面未指定时用全站默认封面
const ogImageFinal = ogImage ?? `${site.url}/images/cover-blog.webp`;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---
<!doctype html>
<html data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- 星空底图在 CSS 里引用，preload 让它更早开始下载（首屏 LCP） -->
    <link rel="preload" as="image" href="/images/bg.webp" fetchpriority="high" />
    <!-- 中文正文字体：思源宋体分片自托管（unicode-range 按需加载，英文不受影响） -->
    <link rel="stylesheet" href="/fonts/noto-serif-sc.css" />
    <!-- 双皮肤：液态玻璃皮肤层（毛玻璃为默认，脚本按存储决定启用哪层） -->
    <link rel="stylesheet" href="/skins/liquid.css" data-skin-liquid />
    <script is:inline>
      (function () {
        // 双皮肤在客户端导航后不会自动保留：View Transitions 换入的 <html>
        // 不带 data-skin，液态玻璃样式层也会恢复默认启用，需按存储再钉一次
        function applySkin() {
          var skin = 'frosted';
          try { skin = localStorage.getItem('woju-skin') || 'frosted'; } catch (e) {}
          document.documentElement.dataset.skin = skin;
          var l = document.querySelector('link[data-skin-liquid]');
          if (l) l.disabled = skin !== 'liquid';
        }
        applySkin();
        document.addEventListener('astro:after-swap', applySkin);
      })();
    </script>
    <ClientRouter />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.url} />
    <meta property="og:image" content={ogImageFinal} />
    <link rel="alternate" type="application/rss+xml" title="Wojusensei 的博客" href="/rss.xml" />
    <script is:inline>
      // 防主题闪烁：渲染前定下亮暗；客户端导航后 html 属性会被新页面重置，需再应用一次
      (function () {
        function applyTheme() {
          try {
            var t = localStorage.getItem('woju-theme');
            if (t !== 'dark' && t !== 'light') {
              t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.dataset.theme = t;
          } catch (e) {}
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <!-- 首次进站加载幕：每会话一次（sessionStorage），客户端导航与后续刷新不出现；3.5s 兜底必消失 -->
    <script is:inline>
      (function () {
        var seen = false;
        var force = false;
        try {
          seen = !!sessionStorage.getItem('woju-veil');
          force = sessionStorage.getItem('woju-veil-force') === '1';
          if (force) sessionStorage.removeItem('woju-veil-force');
        } catch (e) {}
        if (seen && !force) return;
        try { sessionStorage.setItem('woju-veil', '1'); } catch (e) {}
        var d = document.createElement('div');
        d.id = 'load-veil';
        d.innerHTML = '<span class="veil-name">Wojusensei</span><span class="veil-spinner"></span>';
        document.body.insertBefore(d, document.body.firstChild);
        var done = function () {
          d.classList.add('veil-done');
          setTimeout(function () { if (d.parentNode) d.parentNode.removeChild(d); }, 500);
        };
        if (document.readyState === 'complete') done();
        else window.addEventListener('load', done);
        setTimeout(done, 3500);
      })();
    </script>
    <a class="skip-link" href="#main" data-i18n="misc.skip">跳到正文</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DonateModal />
    <BackToTop />
    <button id="skin-toggle" class="skin-toggle" aria-label="切换界面风格" data-i18n-attr="aria-label:misc.skinToggle" title="切换界面风格">
      <Icon name="sparkle" />
    </button>
    <script>
      import '../lib/glass/main';
    </script>
  </body>
</html>
