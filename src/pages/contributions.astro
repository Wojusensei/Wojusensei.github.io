---
// 贡献板块：数据全部在构建时抓取并烘焙进页面（每 6 小时定时重建 + push 触发 + 手动按钮）
// 访客端零 GitHub 请求，与接口限流彻底无关
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contributions } from '../data/contributions';
import { fetchGhStats, fetchUpstreamStars } from '../lib/github-data';

const stats = await fetchGhStats();
const upstreamStars = await fetchUpstreamStars(contributions.repos.map((r) => r.repo));

const fmt = (v: number | null) => (v === null ? '–' : String(v));
const rate =
  stats.prs !== null && stats.mergedPrs !== null
    ? Math.round((stats.mergedPrs / stats.prs) * 100) + '%'
    : '–';
// PR 环形图用：合并率数值（null = 数据缺失，环只画轨道）
const rateNum =
  stats.prs !== null && stats.mergedPrs !== null && stats.prs > 0
    ? Math.min(100, Math.round((stats.mergedPrs / stats.prs) * 100))
    : null;
const PR_R = 50;
const PR_CIRC = 2 * Math.PI * PR_R;
const prArc = rateNum === null ? `0 ${PR_CIRC}` : `${(rateNum / 100) * PR_CIRC} ${PR_CIRC}`;

// 语言饼图：逐项纳入语言，直到剩余「其他」低于 1%（站长要求），其余进「其他」
const COLORS = [
  '#8fb0ff', '#b48cff', '#5fd4c4', '#f2cd60', '#ff9e9e', '#7fd1ff', '#9aa7bf',
  '#c9a3ff', '#7fd1a0', '#ffb87f', '#e0a3c4', '#a3b8ff', '#8fd1e8', '#d1c07f',
];
const OTHERS_COLOR = '#9aa7bf';
const R = 70;
const CIRC = 2 * Math.PI * R;
const pieSlices = (() => {
  const langs = [...stats.languages].sort((a, b) => b.bytes - a.bytes);
  const total = langs.reduce((s, d) => s + d.bytes, 0) || 1;
  // 依次纳入，直至剩余字节占比 < 1%
  let acc = 0;
  let n = 0;
  for (let i = 0; i < langs.length; i++) {
    acc += langs[i].bytes;
    n = i + 1;
    if ((total - acc) / total < 0.01) break;
  }
  const shown = langs.slice(0, n);
  const restBytes = total - acc;
  const data = restBytes > 0 ? [...shown, { name: '__others__', bytes: restBytes }] : shown;
  let offset = 0;
  return data.map((d, i) => {
    // 微切片保底 2.5px 弧长：占比再小也在环上可见（track 垫底吸收累计偏移）
    const len = Math.max((d.bytes / total) * CIRC, 2.5);
    const isOthers = d.name === '__others__';
    const seg = {
      color: isOthers ? OTHERS_COLOR : COLORS[i % COLORS.length],
      len,
      offset,
      pct: ((d.bytes / total) * 100).toFixed(1),
      name: d.name,
      others: isOthers,
    };
    offset += len;
    return seg;
  });
})();

// cpython PR：实时列表为空时回退到静态兜底（contributions.ts 的 fallbackPrs）
const fallback = (
  contributions.repos.find((r) => 'fallbackPrs' in r) as
    | { fallbackPrs: { number: number; title: string; url: string; merged: boolean; state?: string }[] }
    | undefined
)?.fallbackPrs ?? [];
const cpythonPrs = stats.cpythonPrs.length ? stats.cpythonPrs : fallback;

const repos = contributions.repos.map((r) => ({
  ...r,
  ghUrl: `https://github.com/${r.repo}`,
}));
---
<Base active="contributions" title="贡献" desc="Wojusensei 对开源社区的贡献">
  <section class="section wrap" style="margin-top:24px">
    <div class="section-head">
      <h1 class="section-title" data-i18n="contrib.title">贡献</h1>
    </div>

    <div class="section-head" style="margin-bottom:14px">
      <h2 class="section-title" style="font-size:1.2rem" data-i18n="contrib.statsTitle">统计面板</h2>
    </div>
    <div class="stats-grid">
      <div class="g-card stat-tile"><span class="stat-num">{fmt(stats.starsEarned)}</span><span class="stat-label" data-i18n="contrib.starsEarned">总 Star 获得数</span></div>
      <div class="g-card stat-tile"><span class="stat-num">{fmt(stats.commits)}</span><span class="stat-label" data-i18n="contrib.commits">总 Commit 数</span></div>
      <!-- 电脑端：PR 三项合并成 2×2 大卡 + 环形图 -->
      <div class="g-card stat-pr-wide">
        <div class="pr-ring">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <defs>
              <linearGradient id="pr-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#8fb0ff" />
                <stop offset="1" stop-color="#b48cff" />
              </linearGradient>
            </defs>
            <circle cx="60" cy="60" r={String(PR_R)} fill="none" stroke="rgba(127,127,140,0.18)" stroke-width="12" />
            <circle
              cx="60" cy="60" r={String(PR_R)}
              fill="none" stroke="url(#pr-grad)" stroke-width="12" stroke-linecap="round"
              stroke-dasharray={prArc}
              transform="rotate(-90 60 60)"
            />
          </svg>
          <div class="pr-ring-center">
            <span class="stat-num">{rate}</span>
            <span class="stat-label" data-i18n="contrib.mergeRate">PR 合并概率</span>
          </div>
        </div>
        <div class="pr-stats">
          <div class="pr-stat"><span class="stat-num">{fmt(stats.prs)}</span><span class="stat-label" data-i18n="contrib.prs">总 PR 数</span></div>
          <div class="pr-stat"><span class="stat-num">{fmt(stats.mergedPrs)}</span><span class="stat-label" data-i18n="contrib.mergedPrs">被 Merge 的 PR 数</span></div>
          <div class="pr-stat"><span class="stat-num">{rate}</span><span class="stat-label" data-i18n="contrib.mergeRate">PR 合并概率</span></div>
        </div>
      </div>
      <div class="g-card stat-tile"><span class="stat-num">{fmt(stats.issues)}</span><span class="stat-label" data-i18n="contrib.issues">提起的总 Issue 数</span></div>
      <div class="g-card stat-tile"><span class="stat-num">{fmt(stats.reviews)}</span><span class="stat-label" data-i18n="contrib.reviews">代码审查次数</span></div>
    </div>

    <div class="g-card pie-card" style="margin-top:18px">
      {pieSlices.length > 0 && (
        <svg class="pie-donut" viewBox="0 0 200 200" aria-hidden="true">
          <!-- 轨道垫底：填满小切片之间的亚像素缝隙，避免背景透出形成暗色缺口 -->
          <circle cx="100" cy="100" r={String(R)} fill="none" stroke="rgba(124, 134, 153, 0.45)" stroke-width="30" />
          {pieSlices.map((d) => (
            <circle
              cx="100" cy="100" r={String(R)}
              fill="none" stroke={d.color} stroke-width="30"
              stroke-dasharray={`${d.len} ${CIRC - d.len}`}
              stroke-dashoffset={String(-d.offset)}
              transform="rotate(-90 100 100)"
            />
          ))}
        </svg>
      )}
      <div class="pie-legend" style={`--legend-rows:${Math.ceil(pieSlices.length / 2)}`}>
        {pieSlices.map((d) => (
          <div class="pl-row">
            <span class="pl-dot" style={`background:${d.color}`}></span>
            {d.others
              ? <span class="pl-name" data-i18n="contrib.others">其他</span>
              : <span class="pl-name">{d.name}</span>}
            <span class="pl-pct">{d.pct}%</span>
          </div>
        ))}
      </div>
      <div style="flex:1;min-width:160px">
        <h3 style="margin:0 0 6px;font-size:1.05rem" data-i18n="contrib.pieTitle">常用编程语言比例</h3>
        <p class="section-desc" style="font-size:.86rem" data-i18n="contrib.pieNote">按公开仓库的代码字节统计，数据在构建时抓取，每 6 小时自动刷新。</p>
      </div>
    </div>

    <div class="section-head" style="margin:52px 0 14px">
      <h2 class="section-title" style="font-size:1.2rem" data-i18n="contrib.reposTitle">贡献过的高星仓库</h2>
    </div>
    <div class="grid cols-2">
      {repos.map((r) => (
        <div class="g-card contrib-card">
          <div class="wc-head">
            <h3><a href={r.ghUrl} target="_blank" rel="noopener" style="color:var(--text)">{r.repo.split('/')[1]}</a></h3>
            <span class="stars-badge on">
              <Icon name="star" /><span class="stars-num">{upstreamStars[r.repo] ?? '–'}</span>
            </span>
          </div>
          <p class="contrib-note" data-lang-zh>{r.note}</p>
          <p class="contrib-note" data-lang-en style="display:none">{r.noteEn}</p>

          {'plugins' in r && r.plugins ? (
            <div style="margin-top:10px">
              <h4 style="margin:0 0 6px;font-size:.9rem;color:var(--text-2)" data-i18n="contrib.pluginsTitle">旗下插件</h4>
              <div class="plugin-list">
                {r.plugins.map((p) => (
                  <a class="plugin-row" href={`https://github.com/${p}`} target="_blank" rel="noopener">
                    <span>{p.replace('nonebot-plugin-', '')}</span>
                    <span class="stars-badge on">
                      <Icon name="star" /><span class="stars-num">{stats.ownStars[p] ?? '–'}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <div style="margin-top:10px">
              <h4 style="margin:0 0 6px;font-size:.9rem;color:var(--text-2)">PR</h4>
              <ul class="pr-list">
                {cpythonPrs.map((pr) => (
                  <li>
                    <span class={`pr-badge ${pr.merged ? 'merged' : pr.state === 'closed' ? 'closed' : 'open'}`}>
                      <span data-lang-zh>{pr.merged ? '已合并' : pr.state === 'closed' ? '未合并' : '待审'}</span>
                      <span data-lang-en style={pr.merged || pr.state === 'closed' ? 'display:none' : ''}>
                        {pr.merged ? 'merged' : pr.state === 'closed' ? 'closed' : 'open'}
                      </span>
                    </span>
                    <a href={pr.url} target="_blank" rel="noopener">#{pr.number} {pr.title}</a>
                  </li>
                ))}
                {cpythonPrs.length === 0 && <li class="section-desc">–</li>}
              </ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
