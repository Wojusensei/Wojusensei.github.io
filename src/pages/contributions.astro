---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contributions } from '../data/contributions';
import { site } from '../data/site';

const repos = contributions.repos.map((r) => ({
  ...r,
  ghUrl: `https://github.com/${r.repo}`,
}));
---
<Base active="contributions" title="贡献" desc="Wojusensei 对开源社区的贡献">
  <section class="section wrap" style="margin-top:24px">
    <div class="section-head">
      <h1 class="section-title" data-i18n="contrib.title">贡献</h1>
    </div>

    <div class="section-head" style="margin-bottom:14px">
      <h2 class="section-title" style="font-size:1.2rem" data-i18n="contrib.statsTitle">统计面板</h2>
    </div>
    <div class="stats-grid">
      <div class="g-card stat-tile"><span class="stat-num" data-stat="starsEarned">–</span><span class="stat-label" data-i18n="contrib.starsEarned">总 Star 获得数</span></div>
      <div class="g-card stat-tile"><span class="stat-num" data-stat="commits">–</span><span class="stat-label" data-i18n="contrib.commits">总 Commit 数</span></div>
      <div class="g-card stat-tile"><span class="stat-num" data-stat="prs">–</span><span class="stat-label" data-i18n="contrib.prs">总 PR 数</span></div>
      <div class="g-card stat-tile"><span class="stat-num" data-stat="mergedPrs">–</span><span class="stat-label" data-i18n="contrib.mergedPrs">被 Merge 的 PR 数</span></div>
      <div class="g-card stat-tile"><span class="stat-num" data-stat="mergeRate">–</span><span class="stat-label" data-i18n="contrib.mergeRate">PR 合并概率</span></div>
      <div class="g-card stat-tile"><span class="stat-num" data-stat="issues">–</span><span class="stat-label" data-i18n="contrib.issues">提起的总 Issue 数</span></div>
      <div class="g-card stat-tile"><span class="stat-num" data-stat="reviews">–</span><span class="stat-label" data-i18n="contrib.reviews">代码审查次数</span></div>
    </div>

    <div class="g-card pie-card" style="margin-top:18px">
      <svg class="pie-donut" id="lang-pie" viewBox="0 0 200 200" aria-hidden="true"></svg>
      <div class="pie-legend" id="lang-legend"></div>
      <div style="flex:1;min-width:160px">
        <h3 style="margin:0 0 6px;font-size:1.05rem" data-i18n="contrib.pieTitle">常用编程语言比例</h3>
        <p class="section-desc" style="font-size:.86rem" data-i18n="contrib.pieNote">按公开仓库的代码字节统计，数据来自 GitHub，缓存 1 小时。</p>
      </div>
    </div>

    <div class="section-head" style="margin:52px 0 14px">
      <h2 class="section-title" style="font-size:1.2rem" data-i18n="contrib.reposTitle">贡献过的高星仓库</h2>
    </div>
    <div class="grid cols-2">
      {repos.map((r) => (
        <div class="g-card contrib-card">
          <div class="wc-head">
            <h3><a href={r.ghUrl} target="_blank" rel="noopener" style="color:var(--text)">{r.repo.split('/')[1]}</a></h3>
            <span class="stars-badge on"><Icon name="star" /><span class="stars-num" data-repo-stars={r.repo}>–</span></span>
          </div>
          <p class="contrib-note" data-lang-zh>{r.note}</p>
          <p class="contrib-note" data-lang-en style="display:none">{r.noteEn}</p>

          {'plugins' in r && r.plugins ? (
            <div style="margin-top:10px">
              <h4 style="margin:0 0 6px;font-size:.9rem;color:var(--text-2)" data-i18n="contrib.pluginsTitle">旗下插件</h4>
              <div class="plugin-list">
                {r.plugins.map((p) => (
                  <a class="plugin-row" href={`${site.socials.github}/${p}`} target="_blank" rel="noopener">
                    <span>{p.replace('nonebot-plugin-', '')}</span>
                    <span class="stars-badge on"><Icon name="star" /><span data-plugin-stars={p}>–</span></span>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <div style="margin-top:10px">
              <h4 style="margin:0 0 6px;font-size:.9rem;color:var(--text-2)">PR</h4>
              <ul class="pr-list" id="cpython-prs"><li class="section-desc">…</li></ul>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
<script>
  import { loadContribStats, loadPluginStars } from '../lib/contrib-stats';
  import { contributions } from '../data/contributions';

  function setStat(key: string, val: string) {
    const el = document.querySelector<HTMLElement>(`[data-stat="${key}"]`);
    if (el) el.textContent = val;
  }

  function renderPie(languages: { name: string; bytes: number }[]) {
    const svg = document.getElementById('lang-pie');
    const legend = document.getElementById('lang-legend');
    if (!svg || !legend) return;
    if (!languages.length) return;
    const top = languages.slice(0, 6);
    const rest = languages.slice(6);
    const data = rest.length
      ? [...top, { name: getOthersLabel(), bytes: rest.reduce((s, d) => s + d.bytes, 0) }]
      : top;
    const total = data.reduce((s, d) => s + d.bytes, 0) || 1;
    const colors = ['#8fb0ff', '#b48cff', '#5fd4c4', '#f2cd60', '#ff9e9e', '#7fd1ff', '#9aa7bf'];
    const R = 70;
    const C = 2 * Math.PI * R;
    let offset = 0;
    const NS = 'http://www.w3.org/2000/svg';
    svg.innerHTML = '';
    const rows: HTMLElement[] = [];
    data.forEach((d, i) => {
      const len = (d.bytes / total) * C;
      const circle = document.createElementNS(NS, 'circle');
      circle.setAttribute('cx', '100');
      circle.setAttribute('cy', '100');
      circle.setAttribute('r', String(R));
      circle.setAttribute('fill', 'none');
      circle.setAttribute('stroke', colors[i % colors.length]);
      circle.setAttribute('stroke-width', '30');
      circle.setAttribute('stroke-dasharray', `${len} ${C - len}`);
      circle.setAttribute('stroke-dashoffset', String(-offset));
      circle.setAttribute('transform', 'rotate(-90 100 100)');
      svg.appendChild(circle);
      offset += len;

      const row = document.createElement('div');
      row.className = 'pl-row';
      const dot = document.createElement('span');
      dot.className = 'pl-dot';
      dot.style.background = colors[i % colors.length];
      const name = document.createElement('span');
      name.className = 'pl-name';
      name.textContent = d.name;
      const pct = document.createElement('span');
      pct.className = 'pl-pct';
      pct.textContent = ((d.bytes / total) * 100).toFixed(1) + '%';
      row.append(dot, name, pct);
      rows.push(row);
    });
    legend.replaceChildren(...rows);
  }

  function getOthersLabel(): string {
    const locale = (localStorage.getItem('woju-lang') as 'zh' | 'en') || 'zh';
    return locale === 'en' ? 'Others' : '其他';
  }

  function renderCpythonPrs(list: { number: number; title: string; url: string; merged: boolean }[]) {
    const ul = document.getElementById('cpython-prs');
    if (!ul) return;
    if (!list.length) {
      // 实时搜索失败时回退到配置里的静态 PR（contributions.ts 的 fallbackPrs）
      list = (contributions.repos.find((r) => 'fallbackPrs' in r) as any)?.fallbackPrs ?? [];
    }
    if (!list.length) {
      ul.innerHTML = '<li class="section-desc">–</li>';
      return;
    }
    const locale = (localStorage.getItem('woju-lang') as 'zh' | 'en') || 'zh';
    ul.innerHTML = '';
    for (const pr of list) {
      const li = document.createElement('li');
      const badge = document.createElement('span');
      badge.className = 'pr-badge ' + (pr.merged ? 'merged' : 'open');
      badge.textContent = pr.merged
        ? locale === 'en' ? 'merged' : '已合并'
        : locale === 'en' ? 'open' : '待审';
      const a = document.createElement('a');
      a.href = pr.url;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = `#${pr.number} ${pr.title}`;
      li.append(badge, a);
      ul.appendChild(li);
    }
  }

  const fmt = (v: number | null) => (v === null ? '–' : String(v));
  loadContribStats().then(({ stats }) => {
    if (!stats) return;
    setStat('starsEarned', fmt(stats.starsEarned));
    setStat('commits', fmt(stats.commits));
    setStat('prs', fmt(stats.prs));
    setStat('mergedPrs', fmt(stats.mergedPrs));
    setStat(
      'mergeRate',
      stats.prs !== null && stats.mergedPrs !== null
        ? Math.round((stats.mergedPrs / stats.prs) * 100) + '%'
        : '–',
    );
    setStat('issues', fmt(stats.issues));
    setStat('reviews', fmt(stats.reviews));
    renderPie(stats.languages);
    renderCpythonPrs(stats.cpythonPrs);
  });

  // 插件 star 数
  const pluginRepos = contributions.repos.flatMap((r) => ('plugins' in r && r.plugins ? r.plugins : []));
  loadPluginStars(pluginRepos).then((map) => {
    document.querySelectorAll<HTMLElement>('[data-plugin-stars]').forEach((el) => {
      const name = el.dataset.pluginStars!;
      el.textContent = map[name] !== undefined ? String(map[name]) : '–';
    });
  });

  // 仓库本身的 star 数：取上游高星仓库本体（如 python/cpython），缓存 1 小时
  async function fillRepoStars() {
    const els = document.querySelectorAll<HTMLElement>('[data-repo-stars]');
    const KEY = 'woju-upstream-stars';
    let cache: Record<string, { c: number; ts: number }> = {};
    try {
      cache = JSON.parse(localStorage.getItem(KEY) || '{}');
    } catch { /* 重新拉取 */ }
    for (const el of els) {
      const full = el.dataset.repoStars!;
      const hit = cache[full];
      if (hit && Date.now() - hit.ts < 60 * 60 * 1000) {
        el.textContent = String(hit.c);
        continue;
      }
      try {
        const r = await fetch(`https://api.github.com/repos/${full}`, {
          headers: site.githubToken ? { Authorization: `Bearer ${site.githubToken}` } : {},
        });
        if (!r.ok) continue;
        const info = await r.json();
        el.textContent = String(info.stargazers_count);
        cache[full] = { c: info.stargazers_count, ts: Date.now() };
      } catch { /* 网络失败保持占位 */ }
    }
    localStorage.setItem(KEY, JSON.stringify(cache));
  }
  fillRepoStars();

  // 语言切换时同步 PR 徽章
  window.addEventListener('woju-lang', () => {
    // 触发一次重渲染：从缓存读取即可（若缓存不存在则静默跳过）
    import('../lib/contrib-stats').then(({ loadContribStats }) => {
      loadContribStats().then(({ stats }) => {
        if (stats) renderCpythonPrs(stats.cpythonPrs);
      });
    });
  });
</script>
