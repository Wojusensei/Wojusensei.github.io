---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
---
<Base active="blog" title={post.data.title} desc={post.data.description}>
  <article class="section wrap" style="margin-top:24px;max-width:820px">
    <a href="/blog/" data-i18n="blog.back">← 返回列表</a>
    <div class="post-cover-hero" aria-hidden="true">
      <img src={post.data.cover ?? '/images/cover-default.webp'} alt="" loading="eager" />
    </div>
    <header class="post-header" style="margin-top:20px">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <span>{post.data.date.toISOString().slice(0, 10)}</span>
        {post.data.tags?.map((t) => <span class="tag-pill">{t}</span>)}
        <span data-lang-zh>约 {minutes} 分钟阅读</span>
        <span data-lang-en style="display:none">~{minutes} min read</span>
      </div>
    </header>
    <div class="g-card" style="padding:36px clamp(20px,4vw,44px)">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>
