---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { readingMinutes } from '../../lib/blog';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// 统计条：篇数 / 总字数 / 最近更新
const totalChars = posts.reduce((s, p) => s + (p.body ?? '').replace(/\s/g, '').length, 0);
const wordsLabel = totalChars >= 1000 ? (totalChars / 1000).toFixed(1) + 'k' : String(totalChars);
const latest = posts.length ? posts[0].data.date.toISOString().slice(0, 10) : '';
---
<Base active="blog" title="博客" desc="Wojusensei 的博客：技术笔记、开发日志与随想">
  <section class="section wrap wrap-wide" style="margin-top:24px">
    <div class="section-head">
      <h1 class="section-title" data-i18n="blog.title">博客</h1>
      <p class="section-desc" data-i18n="blog.subtitle">技术笔记、开发日志与随想</p>
    </div>
    {posts.length > 0 && (
      <p class="blog-stats">
        <span data-lang-zh>共 {posts.length} 篇文章 · 约 {wordsLabel} 字 · 最近更新 {latest}</span>
        <span data-lang-en style="display:none">
          {posts.length} posts · ~{wordsLabel} characters · last update {latest}
        </span>
      </p>
    )}
    {posts.length === 0 ? (
      <p class="section-desc" data-i18n="blog.empty">还没有文章，第一篇正在路上。</p>
    ) : (
      <div class="post-list">
        {posts.map((p) => (
          <a class="g-card post-item" href={`/blog/${p.id}/`}>
            <span class="post-cover" transition:name={`post-cover-${p.id}`} aria-hidden="true">
              <img src={p.data.cover ?? '/images/cover-blog.webp'} alt="" loading="lazy" />
            </span>
            <span class="post-body">
              <span class="meta">
                {p.data.date.toISOString().slice(0, 10)}
                <span data-lang-zh> · 约 {readingMinutes(p.body)} 分钟阅读</span>
                <span data-lang-en style="display:none"> · ~{readingMinutes(p.body)} min read</span>
              </span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="post-foot">
                <span class="tag-row">
                  {p.data.tags?.map((t) => <span class="tag-pill">{t}</span>)}
                </span>
                <span class="go" data-i18n="blog.readMore">继续阅读 →</span>
              </span>
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</Base>
